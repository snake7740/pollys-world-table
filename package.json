{
  "name": "pollys-world-table-feed-trade-lab",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Polly Feed & Trade Lab: learn on-chain trade flow by feeding one shared parrot",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node scripts/validate-assets.mjs && node scripts/http-smoke.mjs",
    "check:browser": "python scripts/browser_e2e.py && python scripts/browser_wallet_mock_e2e.py",
    "test:live": "node scripts/live-e2e.mjs",
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "audit": "node scripts/verify-history.mjs",
    "test:e2e": "python scripts/browser_e2e.py",
    "test:e2e:mock": "python scripts/browser_wallet_mock_e2e.py"
  },
  "optionalDependencies": {
    "solc": "0.8.37",
    "viem": "^2.37.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}
